[
  {
    "id": "1.1",
    "segment_id": 1,
    "start": 0.66,
    "end": 2.22,
    "text": "بسم الله الرحمن الرحيم،"
  },
  {
    "id": "1.2",
    "segment_id": 1,
    "start": 2.22,
    "end": 3.92,
    "text": "الحمد لله رب العالمين،"
  },
  {
    "id": "1.3",
    "segment_id": 1,
    "start": 3.92,
    "end": 7.0,
    "text": "والصلاة والسلام على أشرف خلق الله أجمعين،"
  },
  {
    "id": "1.4",
    "segment_id": 1,
    "start": 7.0,
    "end": 11.84,
    "text": "سيدنا محمد وعلى آله وصحبه ومن تبعهم بإحسان إلى يوم الدين."
  },
  {
    "id": "1.5",
    "segment_id": 1,
    "start": 12.26,
    "end": 17.78,
    "text": "وبعد، إن شاء الله اليوم أتحدث عن القرآن الكريم وعن"
  },
  {
    "id": "1.6",
    "segment_id": 1,
    "start": 17.78,
    "end": 23.34,
    "text": "بصمة الكاتب، وكيف يمكن استخدام بصمة الكاتب للتمييز بين"
  },
  {
    "id": "1.7",
    "segment_id": 1,
    "start": 23.34,
    "end": 29.89,
    "text": "الكتاب المختلفين، ولعل أبدأ الحديث بالتذكير بأن أي رسول عندما يرسل"
  },
  {
    "id": "2.1",
    "segment_id": 2,
    "start": 30.32,
    "end": 33.7,
    "text": "الله سبحانه وتعالى يرسله ومعه شيئين،"
  },
  {
    "id": "2.2",
    "segment_id": 2,
    "start": 33.7,
    "end": 38.22,
    "text": "المعجزة التي تدل أنه رسولنا الله سبحانه وتعالى،"
  },
  {
    "id": "2.3",
    "segment_id": 2,
    "start": 38.25,
    "end": 41.91,
    "text": "ثم المنهج الذي ينبغي أن يبلغ لإباده،"
  },
  {
    "id": "2.4",
    "segment_id": 2,
    "start": 42.07,
    "end": 46.59,
    "text": "ولعل سيدنا موسى كان عنده العصابة،"
  },
  {
    "id": "2.5",
    "segment_id": 2,
    "start": 46.59,
    "end": 50.53,
    "text": "كان عنده التوراة، سيدنا إيسى كان يبرئ الأكمح والأبرص،"
  },
  {
    "id": "2.6",
    "segment_id": 2,
    "start": 50.53,
    "end": 52.61,
    "text": "وكذلك كان عنده الإنجيل،"
  },
  {
    "id": "2.7",
    "segment_id": 2,
    "start": 52.61,
    "end": 58.73,
    "text": "إن الرسول صلى الله عليه وسلم المعجزة والمنهج في شيء واحد."
  },
  {
    "id": "3.1",
    "segment_id": 3,
    "start": 59.12,
    "end": 60.96,
    "text": "فالقرآن الكريم هو المعجزة."
  },
  {
    "id": "3.2",
    "segment_id": 3,
    "start": 63.18,
    "end": 68.14,
    "text": "والقرآن نفسه تحدى العرب أن يأتوا بسورة من مثله."
  },
  {
    "id": "3.3",
    "segment_id": 3,
    "start": 68.32,
    "end": 73.32,
    "text": "والله سبحانه وتعالى قال في محكم تنزيله وإن كنتم في ريب مما نزلنا"
  },
  {
    "id": "3.4",
    "segment_id": 3,
    "start": 73.32,
    "end": 79.1,
    "text": "على عبدنا فأتوا بسورة من مثله وادعوا شهداءكم من دون الله إن"
  },
  {
    "id": "3.5",
    "segment_id": 3,
    "start": 79.1,
    "end": 84.34,
    "text": "كنتم صادقين. وفي آية أخرى يقول أم يقولون"
  },
  {
    "id": "3.6",
    "segment_id": 3,
    "start": 84.34,
    "end": 88.52,
    "text": "افتراه؟ قل فأتوا بعشر سورة مثلهم مفتريات."
  },
  {
    "id": "4.1",
    "segment_id": 4,
    "start": 89.03,
    "end": 92.31,
    "text": "وادعوا من استطعتم من دون الله إن كنتم صادقين."
  },
  {
    "id": "4.2",
    "segment_id": 4,
    "start": 92.79,
    "end": 98.01,
    "text": "ثم في آية أخرى يقول قل إن اجتمعت الإنس والجن على أن يأتوا بمثل"
  },
  {
    "id": "4.3",
    "segment_id": 4,
    "start": 98.01,
    "end": 102.99,
    "text": "هذا القرآن لا يأتون بمثله ولو كان بعضهم لبعض ضهيرا."
  },
  {
    "id": "4.4",
    "segment_id": 4,
    "start": 104.38,
    "end": 109.26,
    "text": "طيب نزل فلآن مباشرة للمحتوى بتاع هذا العرض"
  },
  {
    "id": "4.5",
    "segment_id": 4,
    "start": 109.26,
    "end": 114.94,
    "text": "وإن شاء الله حابب أتكلم عن مغدمة سريعة عن بصمة الكاتب وكيف"
  },
  {
    "id": "4.6",
    "segment_id": 4,
    "start": 114.94,
    "end": 116.94,
    "text": "نمكن استخرج من النصوص المختلفة."
  },
  {
    "id": "5.1",
    "segment_id": 5,
    "start": 117.58,
    "end": 122.89,
    "text": "وكيف يمكن استخدامه حتى نجمع تجميع آلي للنصوص"
  },
  {
    "id": "5.2",
    "segment_id": 5,
    "start": 122.89,
    "end": 128.29,
    "text": "بناء على البصمة الكاتب أو بناء على الزمن"
  },
  {
    "id": "5.3",
    "segment_id": 5,
    "start": 128.29,
    "end": 130.54,
    "text": "أو العصر المؤين."
  },
  {
    "id": "5.4",
    "segment_id": 5,
    "start": 131.79,
    "end": 136.27,
    "text": "فإن شاء الله سأقوم بهذا المقدمة ثم سأنتقل للتجربة عن"
  },
  {
    "id": "5.5",
    "segment_id": 5,
    "start": 136.27,
    "end": 140.95,
    "text": "النصر وهي تجربة العشر كتاب."
  },
  {
    "id": "5.6",
    "segment_id": 5,
    "start": 141.05,
    "end": 145.99,
    "text": "بعد ذلك سأنتقل إلى تجربة القرآن الكريم والشعر العربي."
  },
  {
    "id": "6.1",
    "segment_id": 6,
    "start": 147.09,
    "end": 151.23,
    "text": "وسأختم بالخاتمة والنتائج المستخلصة من ذلك."
  },
  {
    "id": "6.2",
    "segment_id": 6,
    "start": 152.26,
    "end": 157.48,
    "text": "طيب، الاستايلومتري أو الأسلوبية الحاسوبية كما يمكن أن"
  },
  {
    "id": "6.3",
    "segment_id": 6,
    "start": 157.48,
    "end": 161.84,
    "text": "نسميها، يعني هي تغنية تستطيع استخدامها عبر الحاسوب"
  },
  {
    "id": "6.4",
    "segment_id": 6,
    "start": 161.87,
    "end": 164.55,
    "text": "وتتعرف على بصمة الكاتب،"
  },
  {
    "id": "6.5",
    "segment_id": 6,
    "start": 164.55,
    "end": 170.19,
    "text": "وكذلك يمكن استخدامها للتعرف على العصور المختلفة أو الأزمان"
  },
  {
    "id": "6.6",
    "segment_id": 6,
    "start": 170.19,
    "end": 174.27,
    "text": "المختلفة التي تمت فيها كتابة هذه الكتابات،"
  },
  {
    "id": "6.7",
    "segment_id": 6,
    "start": 174.27,
    "end": 177.01,
    "text": "سواء كانت أشعار أو نصوص نثرية."
  },
  {
    "id": "7.1",
    "segment_id": 7,
    "start": 178.63,
    "end": 182.19,
    "text": "هذه الخوارزمية تحتمد على نظام تجميع حرمي"
  },
  {
    "id": "7.2",
    "segment_id": 7,
    "start": 182.35,
    "end": 187.89,
    "text": "وتستخلص من النصوص الكلمات الأكثر تكراراً"
  },
  {
    "id": "7.3",
    "segment_id": 7,
    "start": 187.89,
    "end": 193.57,
    "text": "لأنها دائماً تستخدم لكتابة نصوص مختلفة"
  },
  {
    "id": "7.4",
    "segment_id": 7,
    "start": 193.57,
    "end": 195.13,
    "text": "بغض النظر عن الموضوع،"
  },
  {
    "id": "7.5",
    "segment_id": 7,
    "start": 195.13,
    "end": 200.43,
    "text": "فنفس الكاتب سيستخدم نفس حروف الجر وحروف العطف وما شابه"
  },
  {
    "id": "7.6",
    "segment_id": 7,
    "start": 200.43,
    "end": 202.65,
    "text": "لكتابة نصيب مختلفين،"
  },
  {
    "id": "7.7",
    "segment_id": 7,
    "start": 202.65,
    "end": 204.63,
    "text": "واحد في الاقتصاد والآخر في السياسة."
  },
  {
    "id": "7.8",
    "segment_id": 7,
    "start": 204.71,
    "end": 207.33,
    "text": "هذه الكلمات تشكل"
  },
  {
    "id": "8.1",
    "segment_id": 8,
    "start": 207.85,
    "end": 212.63,
    "text": "المتجه الرياضي الذي يشكل البصمة أو بصمة هذا الكاتب."
  },
  {
    "id": "8.2",
    "segment_id": 8,
    "start": 213.01,
    "end": 218.53,
    "text": "بعد ذلك نستخدم طرق القياسة المعروفة وتجمع النصوص في"
  },
  {
    "id": "8.3",
    "segment_id": 8,
    "start": 218.53,
    "end": 223.83,
    "text": "كلستر أو في مجموعات بناء على التشابه في أسلوب"
  },
  {
    "id": "8.4",
    "segment_id": 8,
    "start": 223.83,
    "end": 229.41,
    "text": "الكتابة. طيب هذه الخوارزميات تنظر للنص"
  },
  {
    "id": "8.5",
    "segment_id": 8,
    "start": 229.41,
    "end": 230.93,
    "text": "كأنها متجهات رياضية."
  },
  {
    "id": "8.6",
    "segment_id": 8,
    "start": 231.05,
    "end": 236.15,
    "text": "فعلى سبيل المثال هنا في هذا الرصب متجه رياضي بالأزرق"
  },
  {
    "id": "8.7",
    "segment_id": 8,
    "start": 236.15,
    "end": 238.81,
    "text": "يعبر عنه في سلاسة أبعاد."
  },
  {
    "id": "9.1",
    "segment_id": 9,
    "start": 243.18,
    "end": 248.86,
    "text": "نفس الطريقة ستولد من كل النصوص متجهات رياضية من"
  },
  {
    "id": "9.2",
    "segment_id": 9,
    "start": 248.86,
    "end": 254.44,
    "text": "100 بعد. هذه المتجهات تولد من الكلمات الأكثر"
  },
  {
    "id": "9.3",
    "segment_id": 9,
    "start": 254.44,
    "end": 258.1,
    "text": "تكراراً في الكوربوس أو في المجموعة النصية المرات تحليلة."
  },
  {
    "id": "9.4",
    "segment_id": 9,
    "start": 260.26,
    "end": 264.92,
    "text": "مثلاً، هذه المتجهات التي تم توليدها"
  },
  {
    "id": "9.5",
    "segment_id": 9,
    "start": 264.92,
    "end": 269.34,
    "text": "للنصوص H1 لحد H2."
  },
  {
    "id": "10.1",
    "segment_id": 10,
    "start": 276.9,
    "end": 282.38,
    "text": "الخوارزمية تغيص المسافة ما بين المتجهات المتولدة،"
  },
  {
    "id": "10.2",
    "segment_id": 10,
    "start": 282.38,
    "end": 284.56,
    "text": "وتدمج الأغرب في الأغرب،"
  },
  {
    "id": "10.3",
    "segment_id": 10,
    "start": 284.72,
    "end": 290.34,
    "text": "ثم"
  },
  {
    "id": "10.4",
    "segment_id": 10,
    "start": 290.34,
    "end": 293.86,
    "text": "تدمج المجموعة الكاملة حسب التشابه،"
  },
  {
    "id": "10.5",
    "segment_id": 10,
    "start": 293.86,
    "end": 296.52,
    "text": "فإذا كان في نص مختلف أو بايث زي جيون،"
  },
  {
    "id": "10.6",
    "segment_id": 10,
    "start": 296.52,
    "end": 298.24,
    "text": "يكون في كلسر مختلف."
  },
  {
    "id": "11.1",
    "segment_id": 11,
    "start": 300.2,
    "end": 302.56,
    "text": "طيب، هذه التجربة تجربة مهمة جدا،"
  },
  {
    "id": "11.2",
    "segment_id": 11,
    "start": 302.56,
    "end": 304.88,
    "text": "وهي تجربة الرحال العشرة،"
  },
  {
    "id": "11.3",
    "segment_id": 11,
    "start": 305.04,
    "end": 308.48,
    "text": "فاستخدمنا فيها عشر كتب مختلفة،"
  },
  {
    "id": "11.4",
    "segment_id": 11,
    "start": 308.48,
    "end": 312.34,
    "text": "كتبها كتاب تقريبا عاشوا في نفس الزمن،"
  },
  {
    "id": "11.5",
    "segment_id": 11,
    "start": 312.34,
    "end": 315.4,
    "text": "وكذلك كتب في نفس الموضوع،"
  },
  {
    "id": "11.6",
    "segment_id": 11,
    "start": 315.4,
    "end": 320.44,
    "text": "حاولنا يعني أن نرى هل نحن ممكن نستخدم"
  },
  {
    "id": "11.7",
    "segment_id": 11,
    "start": 320.44,
    "end": 324.84,
    "text": "الكلمات الأكثر تكرارا ونميز بين هذه الكتابات المختلفة،"
  },
  {
    "id": "11.8",
    "segment_id": 11,
    "start": 325.0,
    "end": 328.72,
    "text": "فأخذنا من كل كتاب حوالي عشر عينات،"
  },
  {
    "id": "12.1",
    "segment_id": 12,
    "start": 329.49,
    "end": 333.13,
    "text": "العينات تم أخذها بصورة أشوائية،"
  },
  {
    "id": "12.2",
    "segment_id": 12,
    "start": 333.13,
    "end": 334.93,
    "text": "فعندني، من كل كتاب،"
  },
  {
    "id": "12.3",
    "segment_id": 12,
    "start": 334.93,
    "end": 336.85,
    "text": "من البداية، من النهاية،"
  },
  {
    "id": "12.4",
    "segment_id": 12,
    "start": 336.85,
    "end": 342.27,
    "text": "من الموصف، وكل عينة تم عمل لها reprocessing لكي"
  },
  {
    "id": "12.5",
    "segment_id": 12,
    "start": 342.27,
    "end": 346.17,
    "text": "نتأكد أنه في النهاية المقارنة تتم على features معينة،"
  },
  {
    "id": "12.6",
    "segment_id": 12,
    "start": 346.17,
    "end": 347.91,
    "text": "سواء كانت حروف أو كلمات،"
  },
  {
    "id": "12.7",
    "segment_id": 12,
    "start": 347.91,
    "end": 351.63,
    "text": "هي نفس الكلمات التي ذكرت في العينات المختلفة،"
  },
  {
    "id": "12.8",
    "segment_id": 12,
    "start": 351.63,
    "end": 356.95,
    "text": "وبناء على ذلك قمنا بالمقارنة أو مقارنة المتجهات."
  },
  {
    "id": "13.1",
    "segment_id": 13,
    "start": 357.31,
    "end": 362.7,
    "text": "الذي تولدت من هذه العينات في التجربة الأولى وجدنا أنه"
  },
  {
    "id": "13.2",
    "segment_id": 13,
    "start": 362.7,
    "end": 368.36,
    "text": "الكلستر غير واضح وتم تجميع العينات بصورة"
  },
  {
    "id": "13.3",
    "segment_id": 13,
    "start": 368.36,
    "end": 372.98,
    "text": "خاطئة لأنه كانت التجربة الأولى قطوال المصص فيها قصيرة جدا جدا"
  },
  {
    "id": "13.4",
    "segment_id": 13,
    "start": 372.98,
    "end": 376.72,
    "text": "استخدمنا حوالي 500 كلمة أو أقل من كل كاتب"
  },
  {
    "id": "13.5",
    "segment_id": 13,
    "start": 376.72,
    "end": 382.24,
    "text": "فالكلستر زي ما شايفين ما واضح وغير نظيف أما في"
  },
  {
    "id": "13.6",
    "segment_id": 13,
    "start": 382.24,
    "end": 386.72,
    "text": "التجربة الثانية لمن ضفنا عدد الكلمات وزدنا خلنا من في"
  },
  {
    "id": "14.1",
    "segment_id": 14,
    "start": 386.99,
    "end": 389.29,
    "text": "بأصبحته بكل عين حوالي 2000 كلمة،"
  },
  {
    "id": "14.2",
    "segment_id": 14,
    "start": 389.29,
    "end": 392.51,
    "text": "اتضح أنه الكلسر بيقى مختلف."
  },
  {
    "id": "14.3",
    "segment_id": 14,
    "start": 393.2,
    "end": 398.34,
    "text": "فزي ما شايفين الكلسر اللي عنا أصبحت بير كلير بيقى تجمعت النصوص حسب"
  },
  {
    "id": "14.4",
    "segment_id": 14,
    "start": 398.34,
    "end": 403.78,
    "text": "الكاتب، وهذا يعني دليل على أنه ممكن تجميع الكتابات"
  },
  {
    "id": "14.5",
    "segment_id": 14,
    "start": 403.78,
    "end": 409.3,
    "text": "المختلفة حسب الكاتب بناء على الكلمات"
  },
  {
    "id": "14.6",
    "segment_id": 14,
    "start": 409.3,
    "end": 412.69,
    "text": "الأكثر تكرارا. طيب،"
  },
  {
    "id": "14.7",
    "segment_id": 14,
    "start": 412.69,
    "end": 418.35,
    "text": "التجربة الثانية يعني هي التجربة الأهم بالنسبة لي وهي موضوع هذا العرض."
  },
  {
    "id": "15.1",
    "segment_id": 15,
    "start": 418.7,
    "end": 421.72,
    "text": "وهي مقارنة القرآن الكريم مع الشعر العربي،"
  },
  {
    "id": "15.2",
    "segment_id": 15,
    "start": 421.72,
    "end": 425.08,
    "text": "لأنه الرسول صلى الله عليه وسلم تم اتهامه بأنه شاعر،"
  },
  {
    "id": "15.3",
    "segment_id": 15,
    "start": 425.08,
    "end": 428.66,
    "text": "والتحدي كان أن يأتوا بمثل هذا القرآن،"
  },
  {
    "id": "15.4",
    "segment_id": 15,
    "start": 428.66,
    "end": 430.3,
    "text": "وفشلوا في ذلك،"
  },
  {
    "id": "15.5",
    "segment_id": 15,
    "start": 430.3,
    "end": 434.74,
    "text": "وكانوا يقولوا الكلام الموزون والشعر المغفى وكذا،"
  },
  {
    "id": "15.6",
    "segment_id": 15,
    "start": 434.74,
    "end": 437.76,
    "text": "لكن لم يستطيعوا أن يأتوا بشيء يشبه القرآن."
  },
  {
    "id": "15.7",
    "segment_id": 15,
    "start": 438.02,
    "end": 443.68,
    "text": "ففي هذه التجربة جمعنا النصوص الشعرية من العصر"
  },
  {
    "id": "15.8",
    "segment_id": 15,
    "start": 443.68,
    "end": 445.44,
    "text": "الجاهلي إلى العصر الحديث."
  },
  {
    "id": "16.1",
    "segment_id": 16,
    "start": 447.6,
    "end": 449.86,
    "text": "مدونة أو كورباس كبير جدا جدا،"
  },
  {
    "id": "16.2",
    "segment_id": 16,
    "start": 449.89,
    "end": 454.75,
    "text": "لكي نستطيع أن نغارن هذه النصوص مع القرآن الكريم."
  },
  {
    "id": "16.3",
    "segment_id": 16,
    "start": 455.76,
    "end": 458.2,
    "text": "طيب، لو شايفين هنا،"
  },
  {
    "id": "16.4",
    "segment_id": 16,
    "start": 458.2,
    "end": 463.58,
    "text": "المدونة أو الكورباس قطع عصور مختلفة من العصر الجاهلي"
  },
  {
    "id": "16.5",
    "segment_id": 16,
    "start": 463.58,
    "end": 469.18,
    "text": "والإسلامي والأموي والعباسي والأندلسي والأيوبي والفاطمي والمملوكي"
  },
  {
    "id": "16.6",
    "segment_id": 16,
    "start": 469.18,
    "end": 470.7,
    "text": "والبسماني وحد الحديث."
  },
  {
    "id": "16.7",
    "segment_id": 16,
    "start": 472.39,
    "end": 478.3,
    "text": "فجمعنا هذه المجموعات من الأشعار للكتابة المختلفين."
  },
  {
    "id": "17.1",
    "segment_id": 17,
    "start": 478.72,
    "end": 483.42,
    "text": "فكان المدون أو الكوربوس فيه حوالي"
  },
  {
    "id": "17.2",
    "segment_id": 17,
    "start": 483.42,
    "end": 485.94,
    "text": "قرابة العشر مليون كلمة،"
  },
  {
    "id": "17.3",
    "segment_id": 17,
    "start": 485.94,
    "end": 488.56,
    "text": "لستة مليون شعر،"
  },
  {
    "id": "17.4",
    "segment_id": 17,
    "start": 488.56,
    "end": 492.7,
    "text": "لقرابة الألف شاعر من العصورة الزمنية المختلفة."
  },
  {
    "id": "17.5",
    "segment_id": 17,
    "start": 493.48,
    "end": 498.02,
    "text": "طيب، النتيجة الأولى اللي طلعت لنا عندما استخدمنا النصوص كاملة،"
  },
  {
    "id": "17.6",
    "segment_id": 17,
    "start": 498.05,
    "end": 503.07,
    "text": "إنه زي ما شايفين الـ Two Clusters."
  },
  {
    "id": "17.7",
    "segment_id": 17,
    "start": 503.23,
    "end": 505.49,
    "text": "Cluster فيه القرآن الكريم لوحده."
  },
  {
    "id": "18.1",
    "segment_id": 18,
    "start": 505.93,
    "end": 511.23,
    "text": "والكلستر الآخر على اليمين فيه كل الأشعار من الحقبة الزمنية المختلفة،"
  },
  {
    "id": "18.2",
    "segment_id": 18,
    "start": 511.23,
    "end": 515.89,
    "text": "ودائما شايفين قال أن العصر الأموي أشبه بالعصر الجاهلي،"
  },
  {
    "id": "18.3",
    "segment_id": 18,
    "start": 515.89,
    "end": 518.83,
    "text": "وهما بعد ذاك أشبه بالإسلامي،"
  },
  {
    "id": "18.4",
    "segment_id": 18,
    "start": 518.83,
    "end": 524.37,
    "text": "وتهي تجمع تاني العصور المختلفة في كلسترز"
  },
  {
    "id": "18.5",
    "segment_id": 18,
    "start": 524.37,
    "end": 528.79,
    "text": "مختلفة، فواضح أن القرآن الكريم تميز تماما من هذه النصوص."
  },
  {
    "id": "18.6",
    "segment_id": 18,
    "start": 529.02,
    "end": 530.96,
    "text": "طيب، لمن أخذنا samples،"
  },
  {
    "id": "18.7",
    "segment_id": 18,
    "start": 530.96,
    "end": 534.68,
    "text": "أخذنا عينات من كل عصر،"
  },
  {
    "id": "19.1",
    "segment_id": 19,
    "start": 536.01,
    "end": 541.81,
    "text": "كانت النتيجة أن أيضاً كل"
  },
  {
    "id": "19.2",
    "segment_id": 19,
    "start": 541.81,
    "end": 547.53,
    "text": "العشرة سامبولس التي تأخذت من القرآن الكريم تجمعت لوحدها على اليسار"
  },
  {
    "id": "19.3",
    "segment_id": 19,
    "start": 547.53,
    "end": 551.55,
    "text": "وبقية الأشعار تجمعت في كلسطر على اليمين."
  },
  {
    "id": "19.4",
    "segment_id": 19,
    "start": 552.16,
    "end": 557.8,
    "text": "ولعل هنا في بردو نقطة مهمة جداً دار نبه لها أن هي أن"
  },
  {
    "id": "19.5",
    "segment_id": 19,
    "start": 557.8,
    "end": 563.52,
    "text": "العشرة سامبولس التي تأخذت من الشعر الجاهلي تجمعت قريباً من"
  },
  {
    "id": "19.6",
    "segment_id": 19,
    "start": 563.52,
    "end": 566.66,
    "text": "العصر الأموي ولكن على أي حال تجمعت لوحدها."
  },
  {
    "id": "20.1",
    "segment_id": 20,
    "start": 566.94,
    "end": 570.68,
    "text": "لما يعني إنه عندها صفات وخصائص بتمييزة،"
  },
  {
    "id": "20.2",
    "segment_id": 20,
    "start": 570.91,
    "end": 575.85,
    "text": "وهذا يعني يثبت إنه هناك فعلا شعر جاهلي،"
  },
  {
    "id": "20.3",
    "segment_id": 20,
    "start": 575.85,
    "end": 578.39,
    "text": "ليس كما قال الأستاذ طهر حسين،"
  },
  {
    "id": "20.4",
    "segment_id": 20,
    "start": 578.39,
    "end": 582.45,
    "text": "فينبغي إنه هذا الأمر يدرس بصورة علمية،"
  },
  {
    "id": "20.5",
    "segment_id": 20,
    "start": 582.45,
    "end": 587.95,
    "text": "ونحاول نعرف شنو الـ features أو الكلمات أو الحروف أو"
  },
  {
    "id": "20.6",
    "segment_id": 20,
    "start": 587.95,
    "end": 590.13,
    "text": "البجد المضل،"
  },
  {
    "id": "20.7",
    "segment_id": 20,
    "start": 590.13,
    "end": 593.31,
    "text": "وبناء عليها بنى هذا الرسم،"
  },
  {
    "id": "20.8",
    "segment_id": 20,
    "start": 593.31,
    "end": 596.51,
    "text": "وبناء عليها قال إنه هذا الشعر الجاهلي له..."
  },
  {
    "id": "21.1",
    "segment_id": 21,
    "start": 597.06,
    "end": 600.74,
    "text": "صفات مميزة تميزه من باقي العصور كعصر."
  },
  {
    "id": "21.2",
    "segment_id": 21,
    "start": 601.02,
    "end": 603.66,
    "text": "طيب، يبقى السؤال المهم،"
  },
  {
    "id": "21.3",
    "segment_id": 21,
    "start": 603.66,
    "end": 606.92,
    "text": "إذا إحنا عايزين نعرف شنو الـ features،"
  },
  {
    "id": "21.4",
    "segment_id": 21,
    "start": 606.92,
    "end": 611.06,
    "text": "شنو الكلمات اللي تم استخدامها في هذه الـ models وفي هذه الرسومات"
  },
  {
    "id": "21.5",
    "segment_id": 21,
    "start": 611.06,
    "end": 615.34,
    "text": "اللي مميزة القرآن من باقي النصوص وندروسها وكده،"
  },
  {
    "id": "21.6",
    "segment_id": 21,
    "start": 615.34,
    "end": 620.5,
    "text": "فممكن نعم أن نقوم بذلك لكن عبر"
  },
  {
    "id": "21.7",
    "segment_id": 21,
    "start": 620.5,
    "end": 622.5,
    "text": "methods أخرى."
  },
  {
    "id": "22.1",
    "segment_id": 22,
    "start": 622.89,
    "end": 626.81,
    "text": "بي سي اي هي"
  },
  {
    "id": "22.2",
    "segment_id": 22,
    "start": 626.93,
    "end": 632.05,
    "text": "موضوع الشريحة القادمة طبعا"
  },
  {
    "id": "22.3",
    "segment_id": 22,
    "start": 632.76,
    "end": 638.32,
    "text": "بي سي اي هي مثل اه احنا"
  },
  {
    "id": "22.4",
    "segment_id": 22,
    "start": 638.32,
    "end": 643.86,
    "text": "بنحاول كنا في الاول بنعاين للنص اه من خلال المئة"
  },
  {
    "id": "22.5",
    "segment_id": 22,
    "start": 643.86,
    "end": 649.2,
    "text": "كلمة المولدة للمتيحة الرياضي المعني وقياسه وبعده من المتيحات الاخرى"
  },
  {
    "id": "23.1",
    "segment_id": 23,
    "start": 649.48,
    "end": 654.26,
    "text": "الآن دارين عين للنصوص دي بس في في بعدين فقط"
  },
  {
    "id": "23.2",
    "segment_id": 23,
    "start": 654.26,
    "end": 659.4,
    "text": "ولذلك نستخدم هذه التقنية"
  },
  {
    "id": "23.3",
    "segment_id": 23,
    "start": 659.4,
    "end": 665.08,
    "text": "وبتكون في مجموعة من الكلمات هي و والجروبز"
  },
  {
    "id": "23.4",
    "segment_id": 23,
    "start": 665.08,
    "end": 669.24,
    "text": "دي بتكون بتظهر في مجموعة النصوص دي أكتر وفي المجموعة الأخرى أقل"
  },
  {
    "id": "23.5",
    "segment_id": 23,
    "start": 669.24,
    "end": 674.48,
    "text": "على حسب الكلسترين فهنا مثلاً عندنا القرآن الكريم على"
  },
  {
    "id": "23.6",
    "segment_id": 23,
    "start": 674.64,
    "end": 678.4,
    "text": "اليسار ومن حوله بعض الكلمات اللي ميزته"
  },
  {
    "id": "24.1",
    "segment_id": 24,
    "start": 678.91,
    "end": 683.37,
    "text": "وعلى اليمين ستجد باقي الأشعار والكلمات الميزتها،"
  },
  {
    "id": "24.2",
    "segment_id": 24,
    "start": 683.37,
    "end": 688.89,
    "text": "هناك كلمات واضحة مثلاً الله على اليسار هنا جنب القرآن الكريم"
  },
  {
    "id": "24.3",
    "segment_id": 24,
    "start": 688.89,
    "end": 690.45,
    "text": "وهناك الدهر،"
  },
  {
    "id": "24.4",
    "segment_id": 24,
    "start": 690.45,
    "end": 695.75,
    "text": "هذه واضحة جداً لكن هناك كلمات أخرى مثل الإشارة وكذا،"
  },
  {
    "id": "24.5",
    "segment_id": 24,
    "start": 695.75,
    "end": 700.93,
    "text": "هذه محتاجين حقيقةً للإنبوت والمحتاجين للتحليل من أهل اللغة لكي يرون"
  },
  {
    "id": "24.6",
    "segment_id": 24,
    "start": 700.93,
    "end": 706.25,
    "text": "لماذا ظهرت هنا أكثر من الوصوص الأخرى وميزة القرآن الكريم"
  },
  {
    "id": "25.1",
    "segment_id": 25,
    "start": 707.52,
    "end": 711.49,
    "text": "إذا ذهبنا إلى الكلمتين،"
  },
  {
    "id": "25.2",
    "segment_id": 25,
    "start": 711.49,
    "end": 717.11,
    "text": "سنجد أيضاً في شبه الجملة أو في الكلمتين باستخدام تعابير مختلفة،"
  },
  {
    "id": "25.3",
    "segment_id": 25,
    "start": 717.27,
    "end": 721.81,
    "text": "فالقرآن الكريم دائماً وأبداً مختلف في تعابيره،"
  },
  {
    "id": "25.4",
    "segment_id": 25,
    "start": 721.81,
    "end": 723.47,
    "text": "في كلماته، في مفرطاته،"
  },
  {
    "id": "25.5",
    "segment_id": 25,
    "start": 723.53,
    "end": 729.09,
    "text": "التحليل لو سبناه كده ومشينا إلى كمية من الحروف"
  },
  {
    "id": "25.6",
    "segment_id": 25,
    "start": 729.09,
    "end": 731.71,
    "text": "والحرف الأول مثلاً حرف واحد،"
  },
  {
    "id": "25.7",
    "segment_id": 25,
    "start": 731.71,
    "end": 734.21,
    "text": "دي نتيجة أنا أفكر مهمة جداً جداً،"
  },
  {
    "id": "25.8",
    "segment_id": 25,
    "start": 734.21,
    "end": 737.05,
    "text": "يعني تجد أنه في كمية من الحروف ظهرت"
  },
  {
    "id": "26.1",
    "segment_id": 26,
    "start": 737.27,
    "end": 738.79,
    "text": "في جانب القرآن الكريم،"
  },
  {
    "id": "26.2",
    "segment_id": 26,
    "start": 738.79,
    "end": 740.83,
    "text": "أكثر من الأشعار،"
  },
  {
    "id": "26.3",
    "segment_id": 26,
    "start": 740.83,
    "end": 743.69,
    "text": "القرآن الكريم حرك استخدم بصورة أكثر،"
  },
  {
    "id": "26.4",
    "segment_id": 26,
    "start": 743.69,
    "end": 746.77,
    "text": "ما عارف أنا السبب شنو، ممكن يكون ولت من مفردات،"
  },
  {
    "id": "26.5",
    "segment_id": 26,
    "start": 746.77,
    "end": 750.55,
    "text": "فيها الثلمات دي كانت مهملة أو احتكرة،"
  },
  {
    "id": "26.6",
    "segment_id": 26,
    "start": 750.55,
    "end": 753.41,
    "text": "لأنه حتى في العصور اللاحقة ما ظهرت،"
  },
  {
    "id": "26.7",
    "segment_id": 26,
    "start": 753.41,
    "end": 756.43,
    "text": "وإنما هو التميز بهذه الحروف،"
  },
  {
    "id": "26.8",
    "segment_id": 26,
    "start": 756.43,
    "end": 757.91,
    "text": "فمنها مثلا،"
  },
  {
    "id": "26.9",
    "segment_id": 26,
    "start": 757.91,
    "end": 760.19,
    "text": "دي مثلا دي هنا مقارنة،"
  },
  {
    "id": "26.10",
    "segment_id": 26,
    "start": 760.19,
    "end": 761.69,
    "text": "فقط لتكبير الصورة،"
  },
  {
    "id": "26.11",
    "segment_id": 26,
    "start": 761.69,
    "end": 765.33,
    "text": "ما بين القرآن الكريم والأموي والإسلامي والعباس، لكن هي نفسها،"
  },
  {
    "id": "27.1",
    "segment_id": 27,
    "start": 765.72,
    "end": 768.92,
    "text": "نفس الحروف التي ميزتهم من باقي العصر كلها،"
  },
  {
    "id": "27.2",
    "segment_id": 27,
    "start": 768.92,
    "end": 772.72,
    "text": "هل هم الميم والكاف والنون والها والذا،"
  },
  {
    "id": "27.3",
    "segment_id": 27,
    "start": 772.72,
    "end": 774.5,
    "text": "أنا ما أعرف، هي عديم،"
  },
  {
    "id": "27.4",
    "segment_id": 27,
    "start": 774.5,
    "end": 776.0,
    "text": "محتاجين برضو أحلى اللغة هنا،"
  },
  {
    "id": "27.5",
    "segment_id": 27,
    "start": 776.0,
    "end": 777.58,
    "text": "يعني يدون فيها،"
  },
  {
    "id": "27.6",
    "segment_id": 27,
    "start": 777.58,
    "end": 779.0,
    "text": "كما يقولون،"
  },
  {
    "id": "27.7",
    "segment_id": 27,
    "start": 779.0,
    "end": 781.65,
    "text": "رأي علمي. نعم،"
  },
  {
    "id": "27.8",
    "segment_id": 27,
    "start": 781.65,
    "end": 783.29,
    "text": "كذلك إذا استخدمنا حرفين،"
  },
  {
    "id": "27.9",
    "segment_id": 27,
    "start": 783.29,
    "end": 785.19,
    "text": "يعني إذا قطعنا النص إلى حرفين،"
  },
  {
    "id": "27.10",
    "segment_id": 27,
    "start": 785.19,
    "end": 789.79,
    "text": "حرفين، كذلك سنجد القرآن الكريم مختلف ومتفرد،"
  },
  {
    "id": "27.11",
    "segment_id": 27,
    "start": 789.89,
    "end": 792.31,
    "text": "إذا مشينا له ثلاثة حروف،"
  },
  {
    "id": "27.12",
    "segment_id": 27,
    "start": 792.31,
    "end": 794.41,
    "text": "كذلك ستجد المعادلة مختلفة."
  },
  {
    "id": "28.1",
    "segment_id": 28,
    "start": 794.89,
    "end": 800.53,
    "text": "إذا مشينا ليه سبع حروف ونعلو دي فيها حديث"
  },
  {
    "id": "28.2",
    "segment_id": 28,
    "start": 800.53,
    "end": 806.31,
    "text": "بأنه أنا لاحظت فيها أنه حروف الجر قاعد تدخل على الأسماء في"
  },
  {
    "id": "28.3",
    "segment_id": 28,
    "start": 806.31,
    "end": 811.99,
    "text": "القرآن الكريم أكثر ولكن في الشعر الجاهلي زي ما أنا حوضح في الرسمة"
  },
  {
    "id": "28.4",
    "segment_id": 28,
    "start": 811.99,
    "end": 817.73,
    "text": "الشريحة الأخرى كانت قليل جدا في الشعر الجاهلي ظهرت إذا ما"
  },
  {
    "id": "28.5",
    "segment_id": 28,
    "start": 817.73,
    "end": 822.99,
    "text": "أكثر ولكن حروف الجر مع البرتكل أو مع"
  },
  {
    "id": "28.6",
    "segment_id": 28,
    "start": 822.99,
    "end": 824.53,
    "text": "هذا التعريف ال"
  },
  {
    "id": "29.1",
    "segment_id": 29,
    "start": 824.85,
    "end": 827.35,
    "text": "ظهرت كثير هنا في القرآن الكريم،"
  },
  {
    "id": "29.2",
    "segment_id": 29,
    "start": 827.35,
    "end": 832.63,
    "text": "وبعد ذلك أعتقد أن القرآن الكريم حد تغير في طريقة اللغة لأن باقي"
  },
  {
    "id": "29.3",
    "segment_id": 29,
    "start": 832.63,
    "end": 834.05,
    "text": "الأشعار بدأت تستخدم،"
  },
  {
    "id": "29.4",
    "segment_id": 29,
    "start": 834.05,
    "end": 839.83,
    "text": "واضح أنه بدأت تستخدم بالزمن حروف الجر تدخل على ال."
  },
  {
    "id": "29.5",
    "segment_id": 29,
    "start": 840.62,
    "end": 846.37,
    "text": "طبعاً في مقولة أنه سابقاً حروف الجر ما كانت"
  },
  {
    "id": "29.6",
    "segment_id": 29,
    "start": 846.37,
    "end": 849.31,
    "text": "تدخل على الاسم مباشرة كده،"
  },
  {
    "id": "29.7",
    "segment_id": 29,
    "start": 849.31,
    "end": 852.65,
    "text": "والاسم كان بي مجرور يعني مثلاً تقول جميل الوجه،"
  },
  {
    "id": "29.8",
    "segment_id": 29,
    "start": 852.65,
    "end": 854.23,
    "text": "جميل الوجه،"
  },
  {
    "id": "29.9",
    "segment_id": 29,
    "start": 854.23,
    "end": 855.87,
    "text": "أو تقول زي ما قال الشاعر."
  },
  {
    "id": "30.1",
    "segment_id": 30,
    "start": 856.24,
    "end": 858.36,
    "text": "ومهما يكون فيها من عيب،"
  },
  {
    "id": "30.2",
    "segment_id": 30,
    "start": 858.36,
    "end": 861.98,
    "text": "فإني جبان الكلبي مهزول الفصيل."
  },
  {
    "id": "30.3",
    "segment_id": 30,
    "start": 864.18,
    "end": 866.74,
    "text": "قوله أنه دائماً كان يأتي هكذا،"
  },
  {
    "id": "30.4",
    "segment_id": 30,
    "start": 866.74,
    "end": 871.26,
    "text": "وهذه واحدة من النتائج التي قد تعدد القول هذا،"
  },
  {
    "id": "30.5",
    "segment_id": 30,
    "start": 871.26,
    "end": 876.68,
    "text": "ولكن أيضاً نحن نحتاج للتحليل العلمي والفني من أحلى"
  },
  {
    "id": "30.6",
    "segment_id": 30,
    "start": 876.68,
    "end": 881.36,
    "text": "اللغة، ولذلك هذا الأمر ينبغي أن يطرح على أحلى اللغة لأنه يغش أكثر"
  },
  {
    "id": "30.7",
    "segment_id": 30,
    "start": 881.36,
    "end": 886.02,
    "text": "فأكثر. في القاتمة طبعاً يقول أنه"
  },
  {
    "id": "31.1",
    "segment_id": 31,
    "start": 886.51,
    "end": 889.85,
    "text": "القرآن الكريم أسلوبه مختلف تماماً من الشعر،"
  },
  {
    "id": "31.2",
    "segment_id": 31,
    "start": 889.85,
    "end": 893.05,
    "text": "ولا يمكن أن يكون شعر بأي حال من الأحوال،"
  },
  {
    "id": "31.3",
    "segment_id": 31,
    "start": 893.05,
    "end": 894.95,
    "text": "مختلف في كل الخصائص،"
  },
  {
    "id": "31.4",
    "segment_id": 31,
    "start": 894.95,
    "end": 897.77,
    "text": "كل الفيتشيرز، سواء كانت حروف أو كانت كلمات،"
  },
  {
    "id": "31.5",
    "segment_id": 31,
    "start": 897.77,
    "end": 903.53,
    "text": "أو كانت كما نسميها جزء أجزاء من الحروف،"
  },
  {
    "id": "31.6",
    "segment_id": 31,
    "start": 903.53,
    "end": 905.75,
    "text": "حرفين أو سلاسة أو ما شابه،"
  },
  {
    "id": "31.7",
    "segment_id": 31,
    "start": 905.97,
    "end": 911.05,
    "text": "فمختلف تماماً القرآن الكريم في أسلوبه من النصوص الشعرية"
  },
  {
    "id": "31.8",
    "segment_id": 31,
    "start": 911.05,
    "end": 915.23,
    "text": "المختلفة، والقرآن أيضاً هو يعني، والقرآن"
  },
  {
    "id": "32.1",
    "segment_id": 32,
    "start": 915.3,
    "end": 920.94,
    "text": "والقرآن الكريم نفسه ذكر في سورة ياسين وما علمناه الشعر وما"
  },
  {
    "id": "32.2",
    "segment_id": 32,
    "start": 920.94,
    "end": 923.76,
    "text": "ينبغي له إن هو إلا ذكر وقرآن مبين."
  },
  {
    "id": "32.3",
    "segment_id": 32,
    "start": 923.8,
    "end": 928.98,
    "text": "وما ممكن يكون شعر وفي الحق وما هو من قبل شاعر وقليلا ما تؤمنون."
  },
  {
    "id": "33.1",
    "segment_id": 33,
    "start": 929.0,
    "end": 932.54,
    "text": "والشعراء أم يقولون شاعر نتربص به ريب المنون."
  },
  {
    "id": "33.2",
    "segment_id": 33,
    "start": 932.72,
    "end": 935.86,
    "text": "ودعهم يتربصوا إلى أن تغم الساعة."
  },
  {
    "id": "33.3",
    "segment_id": 33,
    "start": 936.06,
    "end": 938.9,
    "text": "يعني سيظل القرآن الكريم مختلف جدا جدا."
  },
  {
    "id": "33.4",
    "segment_id": 33,
    "start": 939.0,
    "end": 942.28,
    "text": "من كل الأشعار من كل النسر من كل شيء."
  },
  {
    "id": "34.1",
    "segment_id": 34,
    "start": 942.5,
    "end": 944.8,
    "text": "ما هو إلا تنزول من رب العالمين."
  },
  {
    "id": "34.2",
    "segment_id": 34,
    "start": 944.86,
    "end": 948.96,
    "text": "وصلى الله عليه وسلم وبارك على سيدنا محمد وعلى آله وصحبه وسلم."
  },
  {
    "id": "35.1",
    "segment_id": 35,
    "start": 949.48,
    "end": 951.88,
    "text": "والسلام عليكم ورحمة الله وبركاته."
  }
]
